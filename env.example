# Template: copy to .env for local development only (`node --env-file=.env ...`).
# In production prefer the *_FILE variants (Docker/Kubernetes secrets) so the
# secrets are not in the process environment.

# From @BotFather. Or TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_BOT_TOKEN=

# Comma-separated "<id>:<base64 of 32 random bytes>"; first encrypts, all decrypt.
# Generate one: echo "k1:$(openssl rand -base64 32)"
# Or ENCRYPTION_KEYS_FILE=/run/secrets/encryption_keys
ENCRYPTION_KEYS=

# Optional
# DATABASE_PATH=./data/bot.db
# ALLOWED_RELAYS=wss://relay.getalbypro.com/blitz
# ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# MAX_PAYMENT_SATS=1000000
# CONNECT_MONTHLY_BUDGET_SATS=100000
# LOG_LEVEL=info
